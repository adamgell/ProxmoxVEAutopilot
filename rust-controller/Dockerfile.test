FROM rust:1.92-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS proof
RUN apt-get update -qq && apt-get install -y --no-install-recommends ansible-core=2.14.18-0+deb12u2 python3-psycopg2=2.9.5-1+b1 procps curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY rust-controller ./rust-controller
COPY autopilot-proxmox/playbooks/_test_long_sleep.yml ./autopilot-proxmox/playbooks/_test_long_sleep.yml
ARG CONTROLLER_GIT_SHA
ENV CONTROLLER_GIT_SHA=${CONTROLLER_GIT_SHA}
RUN cargo build --locked --manifest-path rust-controller/Cargo.toml --workspace --examples --release && cargo build --locked --manifest-path rust-controller/Cargo.toml -p controller-service --release && cargo test --locked --manifest-path rust-controller/Cargo.toml --workspace --all-features --no-run
RUN cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p pve-port && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p operation-controller --test decision && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p operation-controller --test postgres_native support:: -- --test-threads=1
# These service filters execute pure configuration/health, owned credentials,
# loopback HTTP and cancellation boundaries without starting Docker in the image.
RUN cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service config:: && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service health:: && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service pve_credentials:: && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service pve_observation:: && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service runtime::tests::observation_loop && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --bin controller-service runtime::tests::runtime_defensively && cargo test --offline --locked --manifest-path rust-controller/Cargo.toml -p controller-service --test service -- --skip observation_service::authenticated_service_is_visible_but_never_execution_ready_or_a_writer
# Debian's concrete Python shebang includes optional whitespace. Normalize only
# this disposable entrypoint to the accepted registry's exact trusted form.
RUN sed -i '1s|^#! */usr/bin/python3$|#!/usr/bin/python3|' /usr/bin/ansible-playbook
CMD ["/workspace/rust-controller/target/release/controller-service"]
